{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Launch IOGraph",
			"type": "shell",
			"command": "uv run iograph",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": false
			},
			"problemMatcher": []
		},
		{
			"label": "Build IOGraph exe",
			"type": "shell",
			"command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_windows.ps1",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			},
			"problemMatcher": []
		}
	]
}
